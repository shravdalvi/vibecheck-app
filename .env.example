# ============================================================================
# VIBECHECK - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO VERSION CONTROL - It contains secrets!

# ============================================================================
# GENERAL APPLICATION
# ============================================================================
FLAVOR=dev
ENVIRONMENT=local
APP_NAME=Vibecheck
DISPLAY_NAME=Vibecheck: Safe Crowd Guide

# ============================================================================
# BACKEND / FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# SQLite (Development)
DATABASE_URL=sqlite:///vibecheck.db

# PostgreSQL (Production Recommended)
# DATABASE_URL=postgresql://username:password@localhost:5432/vibecheck

# MySQL (Alternative)
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/vibecheck

# ============================================================================
# FRONTEND / API CONFIGURATION
# ============================================================================
# Backend API URL
API_BASE_URL=http://localhost:5000
API_TIMEOUT=30

# WebSocket Configuration
WS_BASE_URL=ws://localhost:5000/socket.io
SOCKETIO_ASYNC_MODE=threading
SOCKETIO_PING_TIMEOUT=60
SOCKETIO_PING_INTERVAL=25

# Event Configuration (default for demo)
DEFAULT_EVENT_CODE=DEMO123
DEFAULT_EVENT_NAME=Demo Concert 2025

# ============================================================================
# AUTHENTICATION / JWT
# ============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True

# ============================================================================
# EMAIL SERVICE (Password reset, notifications)
# ============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@vibecheck.app

# ============================================================================
# FIREBASE CONFIGURATION (Push notifications)
# ============================================================================
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# ============================================================================
# PAYMENT SERVICE (Stripe - if applicable)
# ============================================================================
STRIPE_API_KEY=your-stripe-secret-key
STRIPE_PUBLIC_KEY=your-stripe-public-key

# ============================================================================
# MAP SERVICE (Google Maps - if applicable)
# ============================================================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
MAP_CONFIGURATION_URL=https://api.venueflow.example.com/v1/venue/maps/default

# ============================================================================
# FRONTEND FEATURES & TELEMETRY
# ============================================================================
# Feature Flags
FEATURE_BACKGROUND_LOCATION=true
FEATURE_BATTERY_OPTIMIZATION=true
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_CERTIFICATE_PINNING=false

# Telemetry & Sampling (defaults; can be overridden by server config)
TELEMETRY_INTERVAL_STATIONARY_S=12
TELEMETRY_INTERVAL_WALKING_S=5
TELEMETRY_INTERVAL_HIGH_MOVEMENT_S=2
TELEMETRY_INTERVAL_BACKGROUND_S=10

# Battery Target / Debug
BATTERY_TARGET_DRAIN_PERCENT_PER_HOUR=8
DEBUG_BATTERY_TRACE_ENABLED=false

# Simulation (dev/demo only)
SIMULATION_MODE=false
SIMULATION_PARTICIPANT_COUNT=5
SIMULATION_SPEED_FACTOR=1.0

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================
LOG_LEVEL=debug
LOG_FILE=app.log
LOG_EXCLUDE_COORDINATES=true
LOG_EXCLUDE_PARTICIPANT_IDS=true

# ============================================================================
# ADMIN CREDENTIALS (Development Only)
# ============================================================================
ADMIN_EMAIL=admin@vibecheck.app
ADMIN_PASSWORD=change-this-after-first-login

# ============================================================================
# PRODUCTION SETTINGS (Use only in production)
# ============================================================================
# Uncomment and configure for production:
# FLASK_ENV=production
# FLASK_DEBUG=False
# PREFERRED_URL_SCHEME=https
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_HTTPONLY=True
# SESSION_COOKIE_SAMESITE=Lax

# ============================================================================
# DATABASE SETTINGS FOR PRODUCTION
# ============================================================================
# DATABASE_URL=postgresql://prod_user:strong_password@prod_host:5432/vibecheck_prod

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
# - NEVER commit secrets or this file to version control
# - Use strong, unique passwords and API keys
# - Rotate secrets regularly
# - Use different credentials for dev, staging, and production
# - Store production secrets in a secure vault (AWS Secrets Manager, Vault, etc.)
# - Enable HTTPS in production
# - Use environment variables from CI/CD pipeline

# Connectivity & Retry
HTTP_CONNECTION_TIMEOUT_S=10
HTTP_RECEIVE_TIMEOUT_S=30
HTTP_RETRY_MAX_ATTEMPTS=3
HTTP_BACKOFF_INITIAL_MS=1000
HTTP_BACKOFF_MAX_MS=60000

# Queue & Offline
QUEUE_MAX_SIZE_RECORDS=10000
QUEUE_DROP_POLICY=drop_oldest_low_priority
QUEUE_FLUSH_BATCH_SIZE=100

# Accessibility
FORCE_HIGH_CONTRAST=false
FORCE_LARGE_TEXT=false

# Debug Mode (dev only)
DEBUG_MODE=true
DEBUG_SHOW_FPS=false
DEBUG_SHOW_COORDINATES_ON_MAP=false
